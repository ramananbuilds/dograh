# Dograh — Coolify stack environment
# Copy to .env (Coolify env panel, or local for testing) and fill in.
# NEVER commit real values — keep secrets in Coolify's env panel.

# ─── Public origin ────────────────────────────────────────────────────────────
# The domain Coolify's Traefik will serve this on. Must resolve to the server's
# public IP, and ports 80/443 must reach Coolify's proxy.
PUBLIC_HOST=dograh.example.com

# ─── TURN / WebRTC media ──────────────────────────────────────────────────────
# coturn publishes UDP 3478 + 49152-49200 on the host. TURN_HOST must be the
# server public IP or a domain resolving to it. Open those UDP ports in the
# firewall or calls connect with no audio.
TURN_HOST=203.0.113.10
TURN_SECRET=change-me-strong-random

# ─── Secrets (required) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-random
REDIS_PASSWORD=change-me-strong-random
OSS_JWT_SECRET=change-me-strong-random

# ─── MinIO (bundled, used for voice recordings) ───────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-random

# ─── Coolify Traefik wiring ───────────────────────────────────────────────────
# Network Coolify's proxy is attached to. On a stock Coolify install this is
# `coolify`. The docker-compose service attaches to it so Traefik can route.
TRAEFIK_NETWORK=coolify
# Traefik entrypoint name for HTTPS (default Coolify entrypoint is `https`).
TRAEFIK_ENTRYPOINT=https
# Traefik certificate resolver (Coolify's default is `letsencrypt`).
TRAEFIK_CERTRESOLVER=letsencrypt

# ─── Optional ─────────────────────────────────────────────────────────────────
# REGISTRY override if you mirror images (api/ui are built from source, minio
# is pulled from dograhai). ENABLE_TELEMETRY=false to disable PostHog.